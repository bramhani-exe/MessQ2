# --- MessQ env template. Copy to .env locally. NEVER commit real secrets. ---
# Frontend (Vite, public): same-origin /api works on Vercel AND local dev (Vite proxy).
VITE_SERVER_URL=/api
VITE_ESP32_URL=http://192.168.1.142/status
VITE_LIVE_MODE=server

# Backend (Vercel Dashboard -> Project -> Settings -> Environment Variables):
# MESSQ_API_KEY=<long-random-secret>           # ESP32 x-api-key header, required for POST /api/queue + /api/reset
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<upstash-token>
# (Vercel KV names KV_REST_API_URL / KV_REST_API_TOKEN also accepted.)

# Local offline fallback only (optional, laptop demo):
# MESSQ_PORT=3001
# MESSQ_API_KEY=<same-dev-key-as-esp32-ino>
